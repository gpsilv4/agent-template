{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa*)",
      "Read(./**/.npmrc)",
      "Read(./**/credentials*)",
      "Read(./**/secrets/**)",
      "Read(./*.pem)",
      "Read(./*.key)",
      "Read(./id_rsa*)",
      "Read(./.npmrc)",
      "Read(./credentials*)",
      "Read(./secrets/**)",
      "Read(./**/id_*)",
      "Read(./**/.envrc)",
      "Read(./**/.netrc)",
      "Read(./**/.pgpass)",
      "Read(./**/.git-credentials)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/*.jks)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.npmrc)",
      "Read(~/.config/gh/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Write(./.claude/settings.local.json)",
      "Write(./.claude/settings.json)",
      "Edit(./.env*)",
      "Edit(./**/.env*)",
      "Write(./.env*)",
      "Write(./**/.env*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -Rf:*)",
      "Bash(rm -fR:*)",
      "Bash(rm -r -f:*)",
      "Bash(rm -f -r:*)",
      "Bash(rm --recursive --force:*)",
      "Bash(git push --force-with-lease:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(gh pr merge:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Edit(./.claude/hooks/**)",
      "Write(./.claude/hooks/**)",
      "Bash(git checkout -b:*)",
      "Bash(git switch -c:*)",
      "Bash(git branch:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(yarn add:*)",
      "Bash(yarn remove:*)",
      "Bash(bun add:*)",
      "Bash(bun remove:*)",
      "Bash(pip install:*)",
      "Edit(./.githooks/**)",
      "Write(./.githooks/**)",
      "Edit(./.claude/agents/**)",
      "Write(./.claude/agents/**)"
    ],
    "allow": [
      "Read(./.agent/**)",
      "Bash(node .agent/scripts/check-doc-versions.mjs)",
      "Bash(node .agent/scripts/check-backlog.mjs)",
      "Bash(node .agent/scripts/check-bundle-sizes.mjs)",
      "Bash(node .agent/scripts/test-guards.mjs)",
      "Bash(node .agent/scripts/test-bundle-sizes.mjs)",
      "Bash(node .agent/scripts/test-backlog.mjs)",
      "Bash(node .agent/scripts/test-mutation-sweep.mjs)",
      "Bash(node .agent/scripts/simulate-derived.mjs)",
      "Bash(node .agent/scripts/test-simulate-derived.mjs)",
      "Bash(node .agent/scripts/test-commit-msg.mjs)",
      "Bash(node .agent/scripts/test-registo.mjs)",
      "Bash(node .agent/scripts/mutation-sweep.mjs)",
      "Bash(node .agent/scripts/mutation-sweep.mjs --list)",
      "Bash(npx tsc --noEmit)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm run test)",
      "Bash(node .agent/scripts/check-test-surface.mjs:*)",
      "Bash(node .agent/scripts/test-test-surface.mjs)",
      "Bash(node .claude/hooks/tests/test-hooks.mjs)",
      "Bash(node .claude/hooks/session-context.mjs)",
      "Bash(node .claude/hooks/stop-verify.mjs)",
      "Bash(npm run test:unit)",
      "Bash(npm run test:e2e)",
      "Bash(npm run test:security)",
      "Bash(npm run test:audit)",
      "Bash(npm run test:all)",
      "Bash(npm run lint:fix)",
      "Bash(node .agent/scripts/mutation-sweep.mjs --only=guards)",
      "Bash(node .agent/scripts/mutation-sweep.mjs --only=check-doc)",
      "Bash(node .agent/scripts/mutation-sweep.mjs --only=check-backlog)",
      "Bash(node .agent/scripts/mutation-sweep.mjs --skips)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-protected-branch.mjs\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.mjs\""
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/reinject-fronteiras.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-verify.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/prompt-fase0.mjs\""
          }
        ]
      }
    ]
  }
}
